# Worker secrets for social sign-in. NEVER commit real values.
# Production: `npx wrangler secret put <NAME>` for each. Local dev: copy to worker/.dev.vars (gitignored) with fake/dev values.
# Public client IDs (GOOGLE_CLIENT_ID, MICROSOFT_CLIENT_ID) and OAUTH_REDIRECT_URIS live in wrangler.toml [vars].

# Google OAuth client (Web application) secret
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration client secret (value, not the secret ID)
MICROSOFT_CLIENT_SECRET=
# AES-GCM key sealing the __Host-oauth state cookie: base64 of 32 random bytes (openssl rand -base64 32)
OAUTH_COOKIE_KEY=

# Existing secrets (unchanged): API_TOKEN, TOTP_ENC_KEY, PII_ENC_KEY, ADMIN_BOOTSTRAP_TOKEN
