/account
  X-Robots-Tag: noindex
/account/*
  X-Robots-Tag: noindex
/signin
  X-Robots-Tag: noindex
/signin/*
  X-Robots-Tag: noindex
/api/*
  X-Robots-Tag: noindex

# Same values as worker/securityHeaders.ts. The asset layer serves HTML, CSS,
# JS, and images without entering the script except where run_worker_first
# matches. The script sets these again on the responses it returns.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://accounts.droptexas.com; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; worker-src 'none'; manifest-src 'none'; media-src 'none'
