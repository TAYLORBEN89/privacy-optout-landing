{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "privacy-optout-landing",
  "main": "./worker/index.ts",
  // Newest compatibility date this Wrangler workerd binary accepts.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Static assets are the Vite build. /api/* is handled by the Worker first.
  // Signups persist in D1. Intended public hostnames: droptexas.com and www.droptexas.com.
  // custom_domain creates proxied DNS in the Cloudflare zone on deploy.
  // Do not deploy until the zone is on this account and the operator asks for it.
  "routes": [
    { "pattern": "droptexas.com", "custom_domain": true },
    { "pattern": "www.droptexas.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drop-texas-signups",
      "database_id": "cc89355c-7f71-4622-a1fc-1dc915909b4a",
      "migrations_dir": "migrations"
    }
  ],
  // The env.API service binding (privacy-dashboard-api) stays off until PR #24
  // lands and is approved. Without it the Worker keeps signups local only.
  // Secret (set with `wrangler secret put`, never committed): SIGNUP_PII_KEY.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
