{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "privacy-optout-landing",
  "main": "./worker/index.ts",
  // Newest compatibility date this Wrangler workerd binary accepts.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Static assets are the Vite build. /api/* is handled by the Worker first.
  // No D1/KV binding yet — persistence is owned by a separate backend.
  // Intended public hostnames: droptexas.com and www.droptexas.com.
  // custom_domain creates proxied DNS in the Cloudflare zone on deploy.
  // Do not deploy until the zone is on this account and the operator asks for it.
  "routes": [
    { "pattern": "droptexas.com", "custom_domain": true },
    { "pattern": "www.droptexas.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
