# Cloudflare Worker base URL (no trailing slash). Build-time config.
VITE_API_URL=https://privacy-dashboard-api.<your-subdomain>.workers.dev
# The access key (the Worker's API_TOKEN secret) is NOT configured here.
# The dashboard asks for it on first load and keeps it in this browser's localStorage.
# Same-origin plan: leave VITE_API_URL empty (the app then calls /api/* on its own origin).
